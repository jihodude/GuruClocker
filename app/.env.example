# guruclocker settings. The program fills in ANTHROPIC_API_KEY for you the first time it runs.
# Lines starting with # are notes and are ignored.

# Your Claude API key, from https://console.anthropic.com -> API Keys (starts with sk-ant-)
ANTHROPIC_API_KEY=

# Which Claude model writes the condensed action steps. Leave empty for the default (claude-opus-5-5).
# Cheaper option: claude-sonnet-5-5
CLAUDE_MODEL=
# How hard Claude thinks: low, medium, high (default), xhigh
CLAUDE_EFFORT=

# Speech-to-text: auto (default), mlx (Apple Silicon Macs), or whisper (everything else)
ASR_BACKEND=
# Whisper model when ASR_BACKEND is whisper. Empty = large-v3-turbo on an NVIDIA GPU, small on CPU.
# Faster but rougher: base. More accurate but slower: medium, large-v3.
WHISPER_MODEL=
# auto (default), cuda, or cpu
WHISPER_DEVICE=

# Keep the downloaded .mp4 next to each transcript? false (default) or true
KEEP_VIDEOS=false

# If Instagram keeps blocking downloads, borrow your browser's login: chrome, edge, firefox, safari
# (You must be logged into Instagram in that browser. Doesn't work in the optional Docker mode.)
COOKIES_BROWSER=

# Where results go. Empty = the 'output' folder next to this file.
OUTPUT_DIR=
