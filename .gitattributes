# Windows needs CRLF line endings in .bat files; Mac/Linux scripts need LF.
*.bat     text eol=crlf
*.command text eol=lf
*.sh      text eol=lf
Makefile  text eol=lf

# Not needed to run the program: leave them out of GitHub's "Download ZIP"
.gitattributes export-ignore
.gitignore     export-ignore
